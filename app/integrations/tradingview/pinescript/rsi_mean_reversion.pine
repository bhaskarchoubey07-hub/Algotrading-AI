//@version=6
strategy("AlgoTrade AI — RSI Range Mean Reversion [v6]", overlay=false, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

rsi_len = input.int(14, "RSI Length")
oversold = input.int(30, "Oversold Threshold")
overbought = input.int(70, "Overbought Threshold")
passphrase = input.string("your_webhook_secret_here", "AlgoTrade Secret Passphrase")

rsi = ta.rsi(close, rsi_len)

buy_signal = ta.crossover(rsi, oversold)
sell_signal = ta.crossunder(rsi, overbought)

if buy_signal
    strategy.entry("Long", strategy.long)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "rsi_bollinger_range",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "long",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "passphrase": "{7}",\n  "rationale": "RSI oversold mean-reversion bounce"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

if sell_signal
    strategy.entry("Short", strategy.short)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "rsi_bollinger_range",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "short",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "passphrase": "{7}",\n  "rationale": "RSI overbought mean-reversion reversal"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

plot(rsi, "RSI", color=color.blue)
hline(oversold, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(overbought, "Overbought", color=color.red, linestyle=hline.style_dashed)
