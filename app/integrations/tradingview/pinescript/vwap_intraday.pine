//@version=6
strategy("AlgoTrade AI — Session VWAP Surge [v6]", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

rvol_len = input.int(20, "RVOL Moving Average Length")
rvol_mult = input.float(1.3, "RVOL Minimum Surge Multiplier")
passphrase = input.string("your_webhook_secret_here", "AlgoTrade Secret Passphrase")

// Session-anchored VWAP
my_vwap = ta.vwap(hlc3)
vol_ma = ta.sma(volume, rvol_len)
rvol = volume / vol_ma

long_cond = ta.crossover(close, my_vwap) and rvol >= rvol_mult
short_cond = ta.crossunder(close, my_vwap) and rvol >= rvol_mult

if long_cond
    strategy.entry("Long", strategy.long)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "vwap_volume_intraday",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "long",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "suggested_stop": {7},\n  "passphrase": "{8}",\n  "rationale": "Session VWAP cross up with volume surge"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), str.tostring(my_vwap * 0.995), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

if short_cond
    strategy.entry("Short", strategy.short)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "vwap_volume_intraday",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "short",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "suggested_stop": {7},\n  "passphrase": "{8}",\n  "rationale": "Session VWAP cross down with volume breakdown"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), str.tostring(my_vwap * 1.005), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

plot(my_vwap, "Session VWAP", color=color.orange, linewidth=2)
