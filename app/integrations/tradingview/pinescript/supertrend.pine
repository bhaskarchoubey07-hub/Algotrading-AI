//@version=6
strategy("AlgoTrade AI — Supertrend Following [v6]", overlay=true, initial_capital=1000000, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

atr_period = input.int(10, "ATR Period", minval=1)
multiplier = input.float(3.0, "Multiplier", minval=0.1, step=0.1)
passphrase = input.string("your_webhook_secret_here", "AlgoTrade Secret Passphrase")

[supertrend, direction] = ta.supertrend(multiplier, atr_period)

is_bullish = ta.crossover(close, supertrend)
is_bearish = ta.crossunder(close, supertrend)

if is_bullish
    strategy.entry("Long", strategy.long)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "supertrend",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "long",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "suggested_stop": {7},\n  "passphrase": "{8}",\n  "rationale": "Supertrend bullish flip"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), str.tostring(supertrend), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

if is_bearish
    strategy.entry("Short", strategy.short)
    alert_json = str.format('{{\n  "event_id": "{0}_{1}_{2}",\n  "strategy_id": "supertrend",\n  "strategy_version": "1.0.0",\n  "symbol": "{3}",\n  "exchange": "NSE",\n  "timeframe": "{4}",\n  "signal_type": "entry",\n  "direction": "short",\n  "timestamp": "{5}",\n  "reference_price": {6},\n  "suggested_stop": {7},\n  "passphrase": "{8}",\n  "rationale": "Supertrend bearish flip"\n}}', syminfo.ticker, timeframe.period, str.tostring(time), syminfo.ticker, timeframe.period, str.tostring(time), str.tostring(close), str.tostring(supertrend), passphrase)
    alert(alert_json, alert.freq_once_per_bar_close)

plot(direction < 0 ? supertrend : na, "Up Trend", color=color.green, style=plot.style_linebr)
plot(direction > 0 ? supertrend : na, "Down Trend", color=color.red, style=plot.style_linebr)
