# ==============================================================================
# AlgoTrade AI — Production Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env` (or set in Streamlit Cloud Secrets)
# 2. Fill in the values for the services you want to activate.
# 3. For local development without cloud keys, the platform operates in durable
#    SQLite storage and realistic mock market data simulation mode.
# ==============================================================================

# --- Application Runtime & Logging ---
APP_NAME="AlgoTrade AI — Production Trading Workstation"
ENVIRONMENT=development                # 'development', 'staging', or 'production'
LOG_LEVEL=INFO                         # 'DEBUG', 'INFO', 'WARNING', 'ERROR'
API_PORT=8000                          # Port for FastAPI webhook listener

# --- Safety & Regulatory Policy ---
# Live broker execution is strictly compiled out. Paper trading is mandatory.
PAPER_TRADING_ONLY=true
ENABLE_LIVE_EXECUTION_DANGEROUS=false

# --- Supabase PostgreSQL Cloud Persistence ---
# Create a free project at https://supabase.com
# Execute the SQL files in sql/migrations/ in the Supabase SQL editor.
# If left blank, the platform automatically uses a local persistent SQLite database (algotrade.db).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=             # Optional: for server-side elevated persistence
DATABASE_URL=sqlite:///./algotrade.db

# --- Official DhanHQ Broker Integration ---
# Retrieve API credentials from the DhanHQ Developer Portal: https://dhanhq.co/docs/v2/
# SDK version supported: dhanhq v2.3.0
# When configured, authenticates live quote, LTP, and historical OHLCV data.
# When left empty, the platform uses realistic mock market data simulation.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_ENV=sandbox                       # 'sandbox' or 'production'

# --- TradingView Webhook & Alert Receiver ---
# Set a strong alphanumeric passphrase matching the "passphrase" field in your
# TradingView alert payload template or alert header.
TRADINGVIEW_WEBHOOK_SECRET=your_secure_webhook_secret_here

# --- Optional Alert Notification Channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
