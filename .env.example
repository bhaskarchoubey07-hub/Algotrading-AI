# AlgoTrade AI Environment Configuration

APP_NAME="AlgoTrade AI — Production Trading Workstation"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Safety & Execution Boundary (Strictly enforced: paper trading is default)
PAPER_TRADING_ONLY=true
ENABLE_LIVE_EXECUTION_DANGEROUS=false
LIVE_EXECUTION_APPROVAL_TOKEN=

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
DATABASE_URL=sqlite:///./algotrade.db

# DhanHQ Broker Integration (Required only for live data/broker sync)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_ENV=sandbox

# TradingView Webhook Configuration
TRADINGVIEW_WEBHOOK_SECRET=your_secure_webhook_secret_here

# Notification Channels (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=
